# 应用配置
APP_NAME=StudentAgent
APP_ENV=production
DEBUG=false
# Compose production mode is controlled by these explicit switches.
DEPLOY_APP_ENV=production
DEPLOY_DEBUG=false
SECRET_KEY=your_secret_key_here

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=intelligent_qa
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/intelligent_qa

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# JWT 认证
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MODEL_PROVIDER=auto

# 模型 API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 旧系统数据库（可选，用于数据迁移）
LEGACY_MYSQL_HOST=legacy-db
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=legacy_password
LEGACY_MYSQL_DATABASE=qa_assistant
LEGACY_MYSQL_URL=mysql://root:legacy_password@legacy-db:3306/qa_assistant

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost

# 限流配置
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 模型配置（MODEL_PROVIDER=deepseek 时使用以下 Flash 配置）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=2000

# Agent 配置
MAX_TOOL_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
API_WORKERS=1

# SSE 配置
SSE_HEARTBEAT_INTERVAL=15
SSE_TIMEOUT=300

# Nginx TLS（启用前将 fullchain.pem/privkey.pem 挂载到 infra/nginx/certs）
TLS_ENABLED=false
