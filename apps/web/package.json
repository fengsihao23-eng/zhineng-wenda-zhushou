{
  "name": "student-agent-web",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",
    "autoprefixer": "^10.4.17",
    "axios": "^1.6.5",
    "katex": "^0.16.47",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test --config=../../playwright.config.ts",
    "test:e2e:ui": "node ../../node_modules/@playwright/test/cli.js test --ui --config=../../playwright.config.ts",
    "test:e2e:debug": "node ../../node_modules/@playwright/test/cli.js test --debug --config=../../playwright.config.ts",
    "test:e2e:report": "node ../../node_modules/@playwright/test/cli.js show-report ../../playwright-report",
    "test:e2e:headed": "node ../../node_modules/@playwright/test/cli.js test --headed --config=../../playwright.config.ts",
    "test:e2e:chromium": "node ../../node_modules/@playwright/test/cli.js test --project=chromium --config=../../playwright.config.ts"
  }
}
